# ERPNext Version
ERPNEXT_VERSION=v15.95.0

# Database Configuration
# NOTE: Host and Port are managed by the service definitions but customizable if needed.
# For coolify.yaml, these are defaulted to service names.
DB_ROOT_PASSWORD=your_secure_db_password

# Admin Password for the new site
ADMIN_PASSWORD=your_secure_admin_password

# Site and Routing
FRAPPE_SITE_NAME_HEADER=frontend
FRAPPE_PORT=8080
